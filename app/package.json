{
  "name": "ai-apprentice-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Evidence-backed workflow learning and coaching",
  "author": "AI Apprentice",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "test": "vitest run",
    "test:desktop": "playwright test",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "radix-ui": "^1.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0",
    "ws": "^8.18.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.5.1",
    "electron-builder": "26.15.3",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.aiapprentice.desktop",
    "productName": "AI Apprentice",
    "directories": {
      "output": "../release/electron"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "assets/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/backend",
        "to": "backend"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Record an answer or voice note when you choose Voice.",
        "NSScreenCaptureUsageDescription": "Record the screen or window you select to document your workflow."
      }
    }
  }
}
